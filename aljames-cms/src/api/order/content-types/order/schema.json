{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "customerName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "shippingAddress": {
      "type": "text"
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": [
        "COD",
        "GCash"
      ]
    },
    "order_status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Processing",
        "Completed",
        "Cancelled"
      ]
    },
    "totalAmount": {
      "type": "decimal"
    },
    "totalItems": {
      "type": "integer"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    }
  }
}
